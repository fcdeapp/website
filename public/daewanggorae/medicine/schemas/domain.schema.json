{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical-textbook:domain:1.0.0",
  "type": "object",
  "required": [
    "id",
    "subjectIds",
    "subjects",
    "targetBodyCharacters",
    "minimumProseFractionBeforeNextDomain",
    "minimumBodyCharactersBeforeNextDomain",
    "progressPath",
    "readerPath",
    "evidencePath",
    "packageFile",
    "sharedPackage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z-]+$"
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^domains/"
          }
        }
      }
    },
    "targetBodyCharacters": {
      "type": "integer",
      "minimum": 1
    },
    "minimumProseFractionBeforeNextDomain": {
      "const": 0.1
    },
    "minimumBodyCharactersBeforeNextDomain": {
      "type": "integer",
      "minimum": 1
    }
  }
}
