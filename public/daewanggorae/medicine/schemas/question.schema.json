{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daewanggorae question with optional media",
  "type": "object",
  "required": [
    "id",
    "kind",
    "lessonId",
    "prompt",
    "options",
    "answer",
    "explanation",
    "optionRationales",
    "verificationStatus"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 240
    },
    "kind": {
      "const": "original_concept_question"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 240
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "maxLength": 240
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "answer": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "maxLength": 240
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "optionRationales": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "verificationStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "media": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                    "maxLength": 240
                  },
                  "stage": {
                    "enum": [
                      "question",
                      "explanation"
                    ]
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "sourceRefs": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                      "maxLength": 240
                    }
                  },
                  "type": {
                    "const": "table"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                          "maxLength": 240
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10000
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10000
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                          "maxLength": 240
                        },
                        "cells": {
                          "type": "array",
                          "maxItems": 12,
                          "items": {
                            "type": [
                              "string",
                              "number"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "cells"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "stage",
                  "type",
                  "title",
                  "columns",
                  "rows"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                    "maxLength": 240
                  },
                  "stage": {
                    "enum": [
                      "question",
                      "explanation"
                    ]
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "sourceRefs": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                      "maxLength": 240
                    }
                  },
                  "type": {
                    "const": "diagram"
                  },
                  "diagramRef": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                    "maxLength": 240
                  }
                },
                "required": [
                  "id",
                  "stage",
                  "type",
                  "diagramRef"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                    "maxLength": 240
                  },
                  "stage": {
                    "enum": [
                      "question",
                      "explanation"
                    ]
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "sourceRefs": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                      "maxLength": 240
                    }
                  },
                  "type": {
                    "const": "anatomy3d"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "sceneRef": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
                    "maxLength": 240
                  }
                },
                "required": [
                  "id",
                  "stage",
                  "type",
                  "title",
                  "sceneRef"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
