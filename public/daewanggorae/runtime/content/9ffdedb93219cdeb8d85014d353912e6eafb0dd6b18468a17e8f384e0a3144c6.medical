      "annotations": [
        {
          "id": "ann.7e56d7719ffedfaa1211",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 77,
            "end": 157,
            "exact": "수용체에 리간드가 결합하는 것과 효율적인 사멸 복합체가 형성되는 것은 구별해야 하며, 수용체 유형과 세포 내 조절단백질에 따라 결과가 달라진다.",
            "prefix": "개시 카스페이스8 등의 활성화에 연결된다. ",
            "suffix": " 모든 TNF 계열 수용체 자극을 즉시 같은"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
