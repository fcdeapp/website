      "annotations": [
        {
          "id": "ann.b8f69f705a87afddbad0",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 141,
            "end": 203,
            "exact": "카스페이스는 인산화효소가 아니라 단백질분해효소이며, 효소 전구체의 존재와 활성화된 효소의 작용을 구별해야 한다.",
            "prefix": " 단백질과 세포 구조가 순차적으로 변한다. ",
            "suffix": " 단백질 총량만 측정하면 절단과 활성의 변화"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
