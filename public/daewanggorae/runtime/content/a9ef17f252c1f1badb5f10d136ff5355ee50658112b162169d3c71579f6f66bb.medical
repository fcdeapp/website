          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 0,
            "end": 55,
            "exact": "Troponin 상승은 심근손상의 근거로 활용되지만 염증의 원인이나 병원체를 단독 확정하지 않는다.",
            "prefix": "",
            "suffix": " 박출률이 유지되어도 전도 질환과 위험 부정"
