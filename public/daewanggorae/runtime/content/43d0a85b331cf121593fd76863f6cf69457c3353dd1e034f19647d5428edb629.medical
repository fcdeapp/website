<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 750" role="img"><title>태반의 두 혈류와 교환</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.placental-separate-streams-0851.e0" d="M165,126 L165,284" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="148.902" y="174.3" width="32.196" height="24.7" fill="#fff"/><text x="165" y="193" font-size="18.7" text-anchor="middle" fill="#657482">혈액</text><path id="diagram.placental-separate-streams-0851.e1" d="M165,376 L165,554" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="148.902" y="434.3" width="32.196" height="24.7" fill="#fff"/><text x="165" y="453" font-size="18.7" text-anchor="middle" fill="#657482">혈액</text><path id="diagram.placental-separate-streams-0851.e2" d="M535,126 L535,284" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="503.755" y="174.3" width="62.49" height="24.7" fill="#fff"/><text x="535" y="193" font-size="18.7" text-anchor="middle" fill="#657482">태아→태반</text><path id="diagram.placental-separate-streams-0851.e3" d="M535,376 L535,554" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="503.755" y="434.3" width="62.49" height="24.7" fill="#fff"/><text x="535" y="453" font-size="18.7" text-anchor="middle" fill="#657482">태반→태아</text><path id="diagram.placental-separate-streams-0851.e4" d="M295,330 L395,330" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)" marker-start="url(#reverse)"/><rect x="328.902" y="299.