          ],
          [
            "초항원",
            "대표적으로 MHC II·특정 Vβ 계통 연결"
          ],
          [
            "Cytokine",
            "반응 결과; 원인 독소의 단독 확정 아님"
          ],
          [
            "배양",
            "균 위치와 독소 효과 위치가 다를 수 있음"
          ]
        ]
      }
    }
  ],
