{
  "id": "question.internal-medicine.diagnosis.probability.001",
  "kind": "original_concept_question",
  "lessonId": "internal-medicine.diagnosis.probability",
  "prompt": "사전확률 20%, 양성우도비 5에서 검사후확률은 약 얼마인가?",
  "options": [
    {
      "id": "A",
      "text": "25%이다."
    },
    {
      "id": "B",
      "text": "55.6%이다."
    },
    {
      "id": "C",
      "text": "100%이다."
    }
  ],
  "answer": "B",
  "explanation": "사전오즈 0.2/0.8=0.25에 5를 곱하면 1.25이고 확률은 1.25/2.25이다.",
  "optionRationales": {
    "A": "0.25는 사전오즈이며 검사후확률로 환산하는 단계가 남아 있다.",
    "B": "정답이다. 사전오즈 0.2/0.8=0.25에 5를 곱하면 1.25이고 확률은 1.25/2.25이다.",
    "C": "양성우도비는 확률에 직접 곱하지 않으며 결과도 100%가 아니다."
  },
  "verificationStatus": "editorial_draft_not_exam_validated",
