<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 1040" role="img"><title>장벽과 신경혈관단위의 역할</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.barrier-cell-roles-0855.e0" d="M350,126 L350,294" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="333.902" y="179.3" width="32.196" height="24.7" fill="#fff"/><text x="350" y="198" font-size="18.7" text-anchor="middle" fill="#657482">접근</text><path id="diagram.barrier-cell-roles-0855.e1" d="M318.4815,386 L196.5185,564" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="221.206" y="444.3" width="72.588" height="24.7" fill="#fff"/><text x="257.5" y="463" font-size="18.7" text-anchor="middle" fill="#657482">선택적 이동</text><path id="diagram.barrier-cell-roles-0855.e2" d="M503.4815,564 L381.5185,386" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="411.255" y="444.3" width="62.49" height="24.7" fill="#fff"/><text x="442.5" y="463" font-size="18.7" text-anchor="middle" fill="#657482">유지 신호</text><path id="diagram.barrier-cell-roles-0855.e3" d="M165,656 L165,834" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="133.755" y="714.3" width="62.49" height="24.7" fill="#fff"/><text x="165" y="733" font-size="18.7" text-anchor="middle" fill="#657482">분포·처리</text><g id="blood"><rect x="200" y="34" width="300" height="92" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">혈액의 물질</text><