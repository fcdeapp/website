            "offsetUnit": "utf16",
            "start": 108,
            "end": 164,
            "exact": "그러므로 도르래신경핵 병변의 눈운동 이상 방향과 이미 교차하여 나온 말초신경의 손상 방향을 구별한다.",
            "prefix": "기 뒤면으로 나오는 독특한 경로를 가진다. ",
            "suffix": " III의 핵군 역시 여러 세포군과 양측 연"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
