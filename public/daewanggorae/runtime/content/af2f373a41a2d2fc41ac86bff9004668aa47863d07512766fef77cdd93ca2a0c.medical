<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 670" role="img"><title>네프론과 집합계의 두 발생 계통</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.kidney-two-origins.edge.1" d="M360,124 L360,186" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="328.755" y="124.3" width="62.49" height="24.7" fill="#fff"/><text x="360" y="143" font-size="18.7" text-anchor="middle" fill="#657482">분지·분화</text><path id="diagram.kidney-two-origins.edge.2" d="M360,424 L360,486" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="323.706" y="424.3" width="72.588" height="24.7" fill="#fff"/><text x="360" y="443" font-size="18.7" text-anchor="middle" fill="#657482">상피화·분화</text><g id="bud"><rect x="115" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">요관싹</text></g><g id="collecting"><rect x="115" y="186" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="237.7" font-size="22" text-anchor="middle" fill="#17212b">요관·깔때기·콩팥잔·집합관</text></g><g id="mesenchyme"><rect x="115" y="336" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="387.7" font-size="22" text-anchor="middle" fill="#17212b">뒤콩팥간엽의 유도 상피</text></g><g id="nephron"><rect x="115" y="486" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="537.7" font-size="22" text-anchor="middle" fill="#17212b">네프론 상피 계통</text></g></g></svg>