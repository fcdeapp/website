<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1040 840" role="img"><title>Apoptosis pathways</title><defs><marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 Z" fill="#78639b"/></marker></defs><rect width="1040" height="840" fill="#fff"/><style>text{font-family:Arial,sans-serif;fill:#292533}.label{font-size:16px}.edge{font-size:13px;fill:#665779}</style><text x="35" y="40" font-size="24">Apoptosis pathways</text><path d="M260.0,180.0 L260.0,294.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="268.0" y="232.0">intrinsic</text><path d="M260.0,360.0 L260.0,474.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="268.0" y="412.0">release</text><path d="M260.0,540.0 L260.0,634.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="268.0" y="582.0">apoptosome</text><path d="M370.0,670.0 L644.0,670.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="518.0" y="662.0">activation</text><path d="M760.0,180.0 L760.0,294.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="768.0" y="232.0">extrinsic</text><path d="M760.0,360.0 L760.0,474.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="768.0" y="412.0">activation</text><path d="M760.0,540.0 L760.0,634.0" stroke="#a08bbc" fill="none" stroke-width="2" marker-end="url(#arrow)"/><text class="edge" x="768.0" y="582.0">activation</text><rect x="150" y="120" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="260" y="155" text-anchor="middle">Intracellular stress</text><rect x="150" y="300" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="260" y="335" text-anchor="middle">BAX/BAK - mitochondria</text><rect x="150" y="480" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="260" y="515" text-anchor="middle">Cytochrome c / APAF1</text><rect x="150" y="640" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="260" y="675" text-anchor="middle">Caspase-9</text><rect x="650" y="120" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="760" y="155" text-anchor="middle">Death receptor</text><rect x="650" y="300" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="760" y="335" text-anchor="middle">Adaptor complex</text><rect x="650" y="480" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="760" y="515" text-anchor="middle">Caspase-8</text><rect x="650" y="640" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="760" y="675" text-anchor="middle">Executioner caspases</text></svg>