<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 1270" role="img"><title>부비동·코눈물관의 배출 위치</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.sinus-drainage.edge.1" d="M360,124 L360,186" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.sinus-drainage.edge.2" d="M360,424 L360,486" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.sinus-drainage.edge.3" d="M360,724 L360,786" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.sinus-drainage.edge.4" d="M360,1024 L360,1086" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><g id="anterior"><rect x="115" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">위턱굴·이마굴·앞/중간벌집</text></g><g id="middle"><rect x="115" y="186" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="237.7" font-size="22" text-anchor="middle" fill="#17212b">중간콧길과 관련 배출로</text></g><g id="posterior"><rect x="115" y="336" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="387.7" font-size="22" text-anchor="middle" fill="#17212b">뒤벌집</text></g><g id="superior"><rect x="115" y="486" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="537.7" font-size="22" text-anchor="middle" fill="#17212b">위콧길</text></g><g id="sphenoid"><rect x="115" y="636" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="687.7" font-size="22" text-anchor="middle" fill="#17212b">나비굴</text></g><g id="recess"><rect x="115" y="786" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="837.7" font-size="22" text-anchor="middle" fill="#17212b">나비벌집오목</text></g><g id="lacrimal"><rect x="115" y="936" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="987.7" font-size="22" text-anchor="middle" fill="#17212b">코눈물관</text></g><g id="inferior"><rect x="115" y="1086" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="1137.7" font-size="22" text-anchor="middle" fill="#17212b">아래콧길</text></g></g></svg>