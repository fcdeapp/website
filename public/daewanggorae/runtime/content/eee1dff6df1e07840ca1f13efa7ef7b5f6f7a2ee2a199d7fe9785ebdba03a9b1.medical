      "annotations": [
        {
          "id": "ann.0ad80971b838562178d0",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 29,
            "end": 94,
            "exact": "신경절의 수용체와 골격근 신경근접합부의 수용체는 소단위 구성 및 약물 반응이 달라 각각 신경형과 근육형으로 구분한다.",
            "prefix": "ACh 수용체는 리간드개폐 양이온통로이다. ",
            "suffix": " 골격근 이완제가 신경근접합부를 차단한다고 "
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
