      }
    },
    {
      "id": "physiology.respiratory.alveolar-equation-deadspace.equation.core",
      "type": "equation",
      "latex": "\\dot V_A=(V_T-V_D)f,\\quad P_{ACO_2}\\simeq\\frac{863\\dot V_{CO_2}}{\\dot V_A}",
      "variables": {
        "VA": "폐포환기 (L/min, BTPS)",
        "VT": "일회호흡량 (L)",
        "VD": "한 호흡 사강부피 (L)",
        "f": "호흡수 (/min)",
