<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 970" role="img"><title>전형적 자율신경의 전달 단계</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.autonomic-transmitters.edge.1" d="M360,124 L360,186" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="338.853" y="124.3" width="42.294" height="24.7" fill="#fff"/><text x="360" y="143" font-size="18.7" text-anchor="middle" fill="#657482">ACh</text><path id="diagram.autonomic-transmitters.edge.2" d="M360,274 L360,336" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="338.853" y="274.3" width="42.294" height="24.7" fill="#fff"/><text x="360" y="293" font-size="18.7" text-anchor="middle" fill="#657482">대부분</text><path id="diagram.autonomic-transmitters.edge.3" d="M360,574 L360,636" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="338.853" y="574.3" width="42.294" height="24.7" fill="#fff"/><text x="360" y="593" font-size="18.7" text-anchor="middle" fill="#657482">ACh</text><path id="diagram.autonomic-transmitters.edge.4" d="M360,724 L360,786" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="338.853" y="724.3" width="42.294" height="24.7" fill="#fff"/><text x="360" y="743" font-size="18.7" text-anchor="middle" fill="#657482">ACh</text><g id="sympre"><rect x="115" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">교감 절전뉴런</text></g><g id="sympost"><rect x="115" y="186" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="237.7" font-size="22" text-anchor="middle" fill="#17212b">신경절 니코틴성 수용체·절후뉴런</text></g><g id="symtarget"><rect x="115" y="336" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="387.7" font-size="22" text-anchor="middle" fill="#17212b">노르에피네프린·아드레날린성 표적</text></g><g id="parapre"><rect x="115" y="486" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="537.7" font-size="22" text-anchor="middle" fill="#17212b">부교감 절전뉴런</text></g><g id="parapost"><rect x="115" y="636" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="687.7" font-size="22" text-anchor="middle" fill="#17212b">신경절 니코틴성 수용체·절후뉴런</text></g><g id="paratarget"><rect x="115" y="786" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="837.7" font-size="22" text-anchor="middle" fill="#17212b">ACh·무스카린성 표적</text></g></g></svg>