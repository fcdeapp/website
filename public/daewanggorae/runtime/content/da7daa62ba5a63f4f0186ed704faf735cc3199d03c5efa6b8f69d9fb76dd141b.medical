          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 149,
            "end": 189,
            "exact": "위 뒤쪽의 염증이나 액체 저류를 영상에서 해석할 때 이 구획을 구분한다.",
            "prefix": "니는 위의 속공간도, 이자 내부도 아니다. ",
            "suffix": ""
          },
          "level": "key",
