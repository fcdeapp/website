      "sourceLengthUtf16": 177,
      "annotations": []
    },
    {
      "blockId": "pharmacology.autonomic.direct-cholinergic-agonists.b.24a931657cb2",
      "sourceSha256": "24a931657cb2d6220af0a266d663ee2d62d13c061c0ba8aa6784d02d81a3d067",
      "sourceLengthUtf16": 190,
      "annotations": [
        {
          "id": "ann.dea54de64e933e161770",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 89,
            "end": 154,
            "exact": "무스카린·니코틴 과자극의 증상은 서로 겹치면서도 다르므로 한 증상 목록만으로 원인 약물이나 중증도를 확정하지 않는다.",
            "prefix": " 동반 약물이 안전성 판단에 영향을 준다. ",
            "suffix": " 실제 금기·용량·모니터링은 제형과 적응증별"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
