        {
          "id": "ann.ae0197bc84c9e4d52641",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 62,
            "end": 157,
            "exact": "약물의 신장 영향에는 혈역학적 기전 외에 간질성 신염 등 다른 경로도 있으므로, NSAID 사용 뒤 신기능이 변했다고 원인을 항상 한 가지 혈관 반응으로 확정하지 않는다.",
            "prefix": "명뿐 아니라 성분과 중복을 확인해야 한다. ",
            "suffix": " 투여 시점·증상·검사와 대체 원인을 함께 "
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
