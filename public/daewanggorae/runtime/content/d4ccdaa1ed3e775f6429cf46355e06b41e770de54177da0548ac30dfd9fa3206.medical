      "sourceSha256": "d084f19710cf239c336ba36034f0e07f886e31d26b73a80c73f25dd7946a41c5",
      "sourceLengthUtf16": 226,
      "annotations": []
    },
    {
      "blockId": "transfusion-medicine.compatibility.components-reactions.b.341e731b7115",
      "sourceSha256": "341e731b711596d213cd05fcb30a1148ee0a7dab44536f909eb13afd02189d78",
      "sourceLengthUtf16": 240,
      "annotations": [
        {
          "id": "ann.6e3e8ec9b3d41e2488f6",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 148,
            "end": 178,
            "exact": "과거 항체 기록과 정확한 환자 식별이 중요한 이유이다.",
            "prefix": "시험은 이런 반응 위험을 줄이는 과정이다. ",
            "suffix": " 검사가 정교해도 다른 사람의 검체를 사용하"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
      "blockId": "transfusion-medicine.compatibility.components-reactions.b.f57c04637ca4",
      "sourceSha256": "f57c04637ca4d8d00783c9cc31da798906a88612e9ea8b9744c7b72ae2146071",
      "sourceLengthUtf16": 237,
      "annotations": [
        {
          "id": "ann.271e1f6ce1d635e616ac",
          "kind": "conceptLink",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 39,
            "end": 41,
            "exact": "보체",
            "prefix": "에서는 항체와 공여 적혈구 항원의 반응 및 ",
            "suffix": " 활성 등이 적혈구 파괴를 일으킬 수 있다."
          },
          "conceptId": "reader.term.841b1d4d1d705967",
          "targetDocumentId": "immunology.innate.complement"
        },
        {
          "id": "ann.593030c31c5c58244fc4",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 141,
            "end": 203,
            "exact": "마취 중인 환자는 통증이나 불안감을 표현하지 못하므로 출혈 양상과 혈역학 변화 등이 중요한 단서가 될 수 있다.",
            "prefix": "견이 처음부터 함께 나타나는 것은 아니다. ",
            "suffix": " 수혈 중 새 이상을 단순한 수술 반응으로만"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
