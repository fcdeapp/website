            "offsetUnit": "utf16",
            "start": 120,
            "end": 169,
            "exact": "Gasdermin D 절단과 막공 형성, pyroptosis는 이 회로의 중요한 결과다.",
            "prefix": "되 종 사이의 단백질 이름을 섞지 않는다. ",
            "suffix": " 세포 밖 LPS 자극과 세포질 전달을 같은"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
