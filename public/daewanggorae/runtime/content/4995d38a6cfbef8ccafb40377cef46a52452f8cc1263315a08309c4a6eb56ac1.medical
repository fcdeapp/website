<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 670" role="img"><title>부갑상샘과 가슴샘의 주머니 유래</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.pouch-migration.edge.1" d="M360,124 L360,186" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="328.755" y="124.3" width="62.49" height="24.7" fill="#fff"/><text x="360" y="143" font-size="18.7" text-anchor="middle" fill="#657482">발생·이동</text><path id="diagram.pouch-migration.edge.2" d="M360,424 L360,486" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="343.902" y="424.3" width="32.196" height="24.7" fill="#fff"/><text x="360" y="443" font-size="18.7" text-anchor="middle" fill="#657482">발생</text><g id="third"><rect x="115" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">셋째 인두주머니</text></g><g id="lower"><rect x="115" y="186" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="237.7" font-size="22" text-anchor="middle" fill="#17212b">아래부갑상샘·가슴샘 상피 계통</text></g><g id="fourth"><rect x="115" y="336" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="387.7" font-size="22" text-anchor="middle" fill="#17212b">넷째 인두주머니</text></g><g id="upper"><rect x="115" y="486" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="537.7" font-size="22" text-anchor="middle" fill="#17212b">위부갑상샘 계통</text></g></g></svg>