        {
          "id": "ann.1d1a3e4c20073ecd7c8d",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 49,
            "end": 107,
            "exact": "축삭 소실과 탈수초의 기록 양상이 다를 수 있지만,단일 진폭·속도 값만으로 모든 병변을 확정하지 않는다.",
            "prefix": "어 느려짐이나 전도 차단을 만들 수 있다. ",
            "suffix": " 시간적 분산은 여러 축삭 반응이 덜 동시에"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
