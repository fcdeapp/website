            "약물의 면역 수용체 상호작용 모형"
          ],
          [
            "변형 펩타이드",
            "제시되는 펩타이드 구성이 바뀔 수 있음"
          ],
          [
            "임상 표현형",
            "기전과 일대일 대응을 가정하지 않음"
          ]
        ]
      }
    }
  ],
