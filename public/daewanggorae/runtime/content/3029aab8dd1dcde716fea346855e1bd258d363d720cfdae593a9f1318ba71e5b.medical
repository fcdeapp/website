          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 195,
            "end": 250,
            "exact": "스트레스가 증상과 생활 기능에 영향을 줄 수 있다는 사실과 만성 염증의 발생 원인은 구분해야 한다.",
            "prefix": "트레스만으로 전체 병인을 설명하지 않는다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
