<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 1020" role="img"><title>접합부 전달의 여러 결정 요인</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.nmj-safety-factors-0853.e0" d="M198.3725,141 L316.6275,304" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="236.353" y="191.8" width="42.294" height="24.7" fill="#fff"/><text x="257.5" y="210.5" font-size="18.7" text-anchor="middle" fill="#657482">방출량</text><path id="diagram.nmj-safety-factors-0853.e1" d="M501.6275,141 L383.3725,304" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="421.353" y="191.8" width="42.294" height="24.7" fill="#fff"/><text x="442.5" y="210.5" font-size="18.7" text-anchor="middle" fill="#657482">반응성</text><path id="diagram.nmj-safety-factors-0853.e2" d="M315.96,396 L199.04,554" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="236.353" y="444.3" width="42.294" height="24.7" fill="#fff"/><text x="257.5" y="463" font-size="18.7" text-anchor="middle" fill="#657482">탈분극</text><path id="diagram.nmj-safety-factors-0853.e3" d="M395,600 L305,600" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="318.755" y="569.3" width="62.49" height="24.7" fill="#fff"/><text x="350" y="588" font-size="18.7" text-anchor="middle" fill="#657482">역치 조건</text><path id="diagram.nmj-safety-factors-0853.e4" d="M165,646 L165,814" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="143.853" y="699.3" width="42.294" height="2