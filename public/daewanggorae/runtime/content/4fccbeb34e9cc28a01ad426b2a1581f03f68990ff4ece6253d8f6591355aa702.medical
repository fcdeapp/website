{"id":"question.pulmonology.obstruction.copd-integrated-assessment.001","kind":"original_concept_question","lessonId":"pulmonology.obstruction.copd-integrated-assessment","media":{"items":[{"columns":[{"id":"c0","label":"항목"},{"id":"c1","label":"자료"}],"id":"question.pulmonology.obstruction.copd-integrated-assessment.001.media.table","rows":[{"cells":["기류 등급","비슷"],"id":"r0"},{"cells":["환자 갑","반복 입원"],"id":"r1"},{"cells":["환자 을","큰 활동 제한·적은 악화"],"id":"r2"},{"cells":["다른 축","심장·근육·용적 차이"],"id":"r3"}],"stage":"question","title":"독립 작성 증례·실험 자료","type":"table"}],"schemaVersion":"1.0.0"},"options":[{"id":"A","text":"입원으로 불린 모든 과거 사건을 원인 확인 없이 COPD 악화로 센다."},{"id":"B","text":"현재 증상·수행과 과거 악화·미래 위험을 별도로 기록하고 다른 기능을 보완한다."},{"id":"C","text":"등급이 같으면 모든 환자의 치료 목표와 위험도 같다."},{"id":"D","text":"기관지확장 반응만으로 천식·COPD를 완벽히 양분한다."}],"prompt":"두 COPD 환자의 FEV1 비율 등급은 비슷하지만 한 명은 반복 입원이 있고 다른 한 명은 악화가 적으면서 큰 운동 제한을 호소한다. 심장과 근육·폐용적도 서로 다르다. 평가를 가장 적절히 나눈 것은?","verificationStatus":"editorial_draft_not_exam_validated"}