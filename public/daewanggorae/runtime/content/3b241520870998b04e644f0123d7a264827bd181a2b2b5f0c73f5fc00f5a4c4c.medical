<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 970" role="img"><title>고막에서 청각신경으로 이어지는 전달</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.hearing-transmission.edge.1" d="M360,124 L360,186" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.hearing-transmission.edge.2" d="M360,274 L360,336" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.hearing-transmission.edge.3" d="M360,424 L360,486" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.hearing-transmission.edge.4" d="M360,574 L360,636" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><path id="diagram.hearing-transmission.edge.5" d="M360,724 L360,786" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><g id="tympanum"><rect x="115" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">고막의 진동</text></g><g id="ossicles"><rect x="115" y="186" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="237.7" font-size="22" text-anchor="middle" fill="#17212b">망치뼈·모루뼈·등자뼈</text></g><g id="oval"><rect x="115" y="336" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="387.7" font-size="22" text-anchor="middle" fill="#17212b">안뜰창과 바깥림프 압력 변화</text></g><g id="basilar"><rect x="115" y="486" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="537.7" font-size="22" text-anchor="middle" fill="#17212b">바닥막·감각털의 상대 운동</text></g><g id="hair"><rect x="115" y="636" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="687.7" font-size="22" text-anchor="middle" fill="#17212b">털세포 수용기전위와 전달물질</text></g><g id="nerve"><rect x="115" y="786" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="360" y="837.7" font-size="22" text-anchor="middle" fill="#17212b">달팽이신경의 활동</text></g></g></svg>