          ]
        ]
      }
    },
    {
      "id": "hpb-surgery.liver.functional-anatomy.diagram.liver-blood-bile-flow-0850",
      "type": "diagram",
      "diagramRef": "diagram.liver-blood-bile-flow-0850",
      "path": "diagrams/diagram.liver-blood-bile-flow-0850.svg",
      "alt": "간의 혈액·담즙 흐름 개념"
    },
    {
      "id": "hpb-surgery.liver.functional-anatomy.3d0850",
      "type": "anatomy3d",
      "sceneRef": "scene.anatomy.abdomen.liver-segments.organ-context"
    },
    {
      "id": "hpb-surgery.liver.functional-anatomy.limits0850",
      "type": "clinicalPearl",
      "markdown": "정상 장기의 위치와 주변 구조 문맥이다. 농양·누공·협착·종양·실제 기능 분절·미세혈류·소작·절제선·환자별 기능과 안전 경로를 이 정적 모델이 표현하거나 정하지 않는다."
    }
  ],
