        {
          "id": "ann.1e572e07306a1a111168",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 62,
            "end": 143,
            "exact": "간샘창자인대 속의 문맥삼합(portal triad)은 큰 구조 수준의 표현이며 현미경에서 보는 문맥공간의 작은 동맥·정맥·담관과 수준을 구별한다.",
            "prefix": "·신경 구조가 드나드는 내장면의 영역이다. ",
            "suffix": " 같은 삼합이라는 이름이 있어도 눈으로 확인"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
