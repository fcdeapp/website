      }
    },
    {
      "id": "genetics.risk.penetrance-bayes.equation.core",
      "type": "equation",
      "latex": "P(H\\mid -)=\\frac{p(1-Se)}{p(1-Se)+(1-p)Sp}",
      "variables": {
        "H": "변이 보유 사건",
        "p": "사전 보유 확률",
        "Se": "P(양성|보유)",
        "Sp": "P(음성|비보유)"
      },
      "assumptions": [
        "제시한 보유 정의와 검사의 성능을 동일 집단에 적용하는 모형",
        "수치 예시는 실제 검사·질환의 성능 추정치가 아니다."
      ]
    }
