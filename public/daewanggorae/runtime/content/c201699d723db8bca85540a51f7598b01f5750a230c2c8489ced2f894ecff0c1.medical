<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 650" role="img"><title>단백질 제거의 두 주요 경로</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.protein-disposal-routes.e0" d="M350,124 L350,181" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="293.51" y="121.8" width="112.98" height="24.7" fill="#fff"/><text x="350" y="140.5" font-size="18.7" text-anchor="middle" fill="#657482">일부 유비퀴틴 표지</text><path id="diagram.protein-disposal-routes.e1" d="M350,414 L350,471" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="303.608" y="411.8" width="92.784" height="24.7" fill="#fff"/><text x="350" y="430.5" font-size="18.7" text-anchor="middle" fill="#657482">유입·융합·분해</text><g id="n0"><rect x="105" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">E1·E2·E3와 기질 표지</text></g><g id="n1"><rect x="105" y="181" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="232.7" font-size="22" text-anchor="middle" fill="#17212b">프로테아좀의 선택적 처리</text></g><g id="n2"><rect x="105" y="326" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="377.7" font-size="22" text-anchor="middle" fill="#17212b">세포질·소기관의 자가포식 전달</text></g><g id="n3"><rect x="105" y="471" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="522.7" font-size="22" text-anchor="mi