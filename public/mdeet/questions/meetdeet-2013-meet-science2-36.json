{"schemaVersion":2,"id":"meetdeet-2013-meet-science2-36","exam":"MEET_DEET","year":2013,"subject":"physics","number":36,"points":1.5,"unitId":"physics-wave-optics","unitLabel":"파동·광학","topic":"파장·굴절·진동수","classificationStatus":"keyword-candidate-unverified","classificationCandidates":["physics-wave-optics"],"stem":"그림은 매질 Ⅰ에서 Ⅱ로 진행하는 파동을 나타낸 것이다. 파동이\n지점 A에서부터 지점 B까지 15m의 거리를 진행하는 데 걸리는 \n시간은 1초이고, Ⅰ에 대한 Ⅱ의 상대 굴절률은 1.5이다.\n매질 Ⅰ에서의 파동에 대한 설명으로 옳은 것만을 <보기>에서 있는 \n대로 고른 것은? [1.5점]\n<보 기>\nㄱ. 속력은 18m/s 이다.\nㄴ. 파장은 6m 이다.\nㄷ. 진동수는 3Hz 이다.","stemTextItemIds":["t001","t002","t003","t004","t005","t006","t007","t008","t009"],"stemAssetIds":["fig-01","fig-02","fig-03","fig-04"],"options":[{"number":1,"text":"ㄱ","assetIds":[],"textItemIds":["t010"]},{"number":2,"text":"ㄷ","assetIds":[],"textItemIds":["t011"]},{"number":3,"text":"ㄱ, ㄴ","assetIds":[],"textItemIds":["t012"]},{"number":4,"text":"ㄴ, ㄷ","assetIds":[],"textItemIds":["t013"]},{"number":5,"text":"ㄱ, ㄴ, ㄷ","assetIds":[],"textItemIds":["t014"]}],"answer":null,"acceptedAnswers":[],"answerStatus":"untranscribed","assets":[{"id":"fig-01","width":27,"height":24,"region":0,"bbox":[158.3,24.503,10.8,9.6],"role":"stem","overlayTextItemIds":[],"src":"/mdeet/assets/meetdeet-2013-meet-science2-36/01.webp"},{"id":"fig-02","width":508,"height":24,"region":0,"bbox":[51.1,42.903,203.2,9.6],"role":"stem","overlayTextItemIds":["t003"],"src":"/mdeet/assets/meetdeet-2013-meet-science2-36/02.webp"},{"id":"fig-03","width":483,"height":185,"region":0,"bbox":[67.9,71.703,193.2,74.0],"role":"stem","overlayTextItemIds":[],"src":"/mdeet/assets/meetdeet-2013-meet-science2-36/03.webp"},{"id":"fig-04","width":776,"height":183,"region":0,"bbox":[14.7,208.903,310.4,73.2],"role":"stem","overlayTextItemIds":["t006","t007","t008","t009"],"src":"/mdeet/assets/meetdeet-2013-meet-science2-36/04.webp"}],"layout":[{"page":16,"sourceRect":[82.9,153.497,417.0,484.762],"width":334.1,"height":331.265,"items":[{"type":"image","assetId":"fig-01","bbox":[158.3,24.5