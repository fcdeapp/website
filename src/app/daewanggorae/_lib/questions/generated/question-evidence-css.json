".measurement-panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:12px}.measurement-panel{margin:0;min-width:0}.measurement-panel figcaption{font-size:14px;margin:0 0 6px}.measurement-panel svg text{font:18px sans-serif}@media print{.measurement-panels{grid-template-columns:repeat(2,minmax(0,1fr))}.measurement-panel:only-child{grid-column:1/-1}.measurement-panel svg{max-height:none}}\n\n\n/* C02/C02-responsive.css */\n/* Apply only to the C02 integration scope. Base renderer and other batches stay unchanged. */\n.c02-batch .c02-vector svg{display:block;width:100%;height:auto;max-width:520px;margin:0 auto}\n.c02-batch .evidence{min-width:0}\n.c02-batch table{max-width:100%;table-layout:fixed}\n.c02-batch th,.c02-batch td{overflow-wrap:anywhere}\n@media print{.c02-batch .c02-vector svg{max-width:420px}.c02-batch article{break-inside:avoid}}\n\n/* C03/p1/styles.css */\n.c03-p1-panels{display:grid;grid-template-columns:1fr;gap:14px}.c03-p1-figure{display:block;width:100%;height:auto;min-width:0}.c03-p1-figure text{font:20px 'Noto Sans CJK KR',sans-serif;fill:#111}.c03-p1-figure .c03-p1-caption{font-size:20px}@media(max-width:480px){.c03-p1-figure text{font-size:22px}.c03-p1-figure .c03-p1-caption{font-size:22px}}@media print{.c03-p1-panels{grid-template-columns:repeat(2,minmax(0,1fr));gap:3mm;align-items:start}.c03-p1-figure{max-height:86mm;width:100%;height:auto}.c03-p1-panels:has(.c03-p1-figure:only-child){grid-template-columns:1fr}.c03-p1-figure text{font-size:20px}}\n\n/* C03/p2/style.css */\n.c03-p2-svg{display:block;width:100%;height:auto;background:#fff}.c03-p2-svg text{font:26px 'Noto Sans CJK KR',sans-serif;fill:#111}.c03-p2-svg .c03-p2-small{font-size:25px}@media print{.c03-p2-svg{max-height:110mm}}\n\n/* C03/p3/style.css */\n.c03-p3-plot{display:block;width:100%;height:auto;max-height:none}.c03-p3-plot text{font:20px 'Noto Sans CJK KR',sans-serif}.c03-p3-figure-note,.c03-p3-asset figcaption{font:12px/1.6 'Noto Sans CJK KR',sans-serif;margin:6px 0}.c03-p3-asset{margin:0}.c03-p3-asset img{display:block;width:100%;height:auto;filter:grayscale(1)}@media print{.c03-p3-plot{max-height:100mm}.c03-p3-asset img{max-height:130mm;object-fit:contain}}\n\n/* C03/p5/styles.css */\n.c03p5-plot{margin:0}.c03p5-plot svg{width:100%;height:auto;display:block}.c03p5-plot svg text{font:20px sans-serif}.c03p5-plot figcaption{font:12px/1.5 sans-serif;margin-top:6px}\n\n/* C03/p6/style.css */\n.c03-p6-anatomy,.c03-p6-crp{width:100%;height:auto;display:block}.c03-p6-anatomy text,.c03-p6-crp text{font:18px \"Noto Sans CJK KR\",sans-serif}@media print{.c03-p6-anatomy,.c03-p6-crp{max-height:100mm}}\n\n/* C04/style.css */\n.C04-vector svg{display:block;width:100%;height:auto}\n.C04-vector small,.C04-photo small{display:block;font:11px/1.4 sans-serif;color:#222}\n.C04-photo{margin:8px 0;min-width:0;flex:1}\n.C04-photo img{display:block;width:100%;height:auto}\n.C04-photo figcaption{font:16px/1.5 sans-serif}\n.C04-histology{display:flex;gap:12px;align-items:start}\n@media(max-width:480px){.C04-histology{display:block}}\n@media print{.C04-vector svg{max-height:215px}.C04-histology{display:flex!important}.C04-photo img{max-height:190px;object-fit:contain}.C04-photo small{font-size:7pt}}\n\n.C04-dual{display:grid;grid-template-columns:1fr 1fr;gap:14px}.C04-dual>div{min-width:0}@media(max-width:480px){.C04-dual{grid-template-columns:1fr}}@media print{.C04-dual{grid-template-columns:1fr 1fr}}\n\n/* C06/C06-responsive.css */\n.c06-batch .evidence table:has(th:nth-child(4)){table-layout:fixed}.c06-batch .evidence table:has(th:nth-child(4)) th:first-child{width:30%}.c06-batch th,.c06-batch td{overflow-wrap:anywhere}.c06-batch .evidence>svg text{font:20px sans-serif}.c06-batch .measurement-panels{grid-template-columns:1fr}.c06-batch .measurement-panel svg text{font-size:21px}@media(max-width:480px){.c06-batch table{font-size:13px}.c06-batch th,.c06-batch td{padding:4px}.c06-batch .measurement-panel svg text{font-size:24px}}\n\n/* C07/style.css */\n.c07-evidence svg{display:block;width:100%;height:auto}.c07-evidence svg text{font:24px sans-serif}.c07-held{border:2px solid #555;padding:20px;font:16px/1.7 sans-serif}.c07-evidence figure{margin:0}.c07-evidence figcaption{font-size:12px}@media print{.c07-evidence svg{max-height:65mm}.c07-evidence figcaption{font-size:8pt}}\n\n/* C10/C10.css */\n.c10-visual{display:grid;gap:12px}.c10-visual svg{width:100%;height:auto;display:block}.c10-visual svg text{font:20px \"Noto Sans CJK KR\",sans-serif}@media print{.c10-visual svg{max-height:48mm}}\n\n/* C08 and shared overflow containment */\n.batch-C08 .c08-panel{margin:0}.batch-C08 .c08-panel svg text{font:22px sans-serif}.batch-C03 th,.batch-C03 td,.batch-C05 th,.batch-C05 td,.batch-C08 th,.batch-C08 td{overflow-wrap:anywhere}.batch-C03 img{max-width:100%;height:auto}.batch-C01 figure{margin:0}.batch-C01 svg{width:100%;height:auto}\n\n.batch-C09 .c09-panel svg text{font:17px sans-serif}\n\n/* R090 real histology. Original pixels and color retained. */\n.r090-histology{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.r090-photo{margin:0;min-width:0}.r090-photo:only-child{grid-column:1/-1}.r090-photo img{display:block;width:100%;height:auto}.r090-photo figcaption{font-size:14px}.r090-photo small,.r090-photo-note{font:11px/1.5 sans-serif}.r090-photo-note{margin:8px 0 0}@media(max-width:480px){.r090-histology{grid-template-columns:1fr}}@media print{.r090-histology{grid-template-columns:repeat(2,minmax(0,1fr))}.r090-photo-note{font-size:8pt}}\n\n.batch-R090 .c09-panel svg text{font:18px sans-serif}.batch-R090 th,.batch-R090 td{overflow-wrap:anywhere}\n\n/* 0.9.2: visible, unified, print-safe question footnotes. */\n.question-note-marker { font-size:.68em; line-height:0; margin-inline-start:.25em; vertical-align:super; }\n.question-note-marker a { color:inherit; text-decoration:none; padding:.2em; }\n.question-footnotes { display:flex; gap:.4em; align-items:flex-start; margin-top:1em; border-top:1px solid #ddd; padding-top:.55em; font-size:.72em; line-height:1.55; color:#626262; overflow-wrap:anywhere; }\n.question-footnotes ul { list-style:none; padding:0; margin:0; flex:1; }\n.question-footnotes li + li { margin-top:.2em; }\n.question-footnotes a { color:inherit; text-underline-offset:.15em; }\n.question-note-marker a:focus-visible, .question-footnotes a:focus-visible { outline:2px solid #765294; outline-offset:2px; }\n.question-footnotes:target { outline:1px solid #b9a4ca; outline-offset:3px; }\n@media (prefers-color-scheme:dark) { .question-footnotes { color:#bdbdbd; border-color:#666; } }\n@media print { .question-footnotes { color:#444; font-size:8pt; display:flex !important; break-inside:avoid; } .question-note-back { display:none; } }\n"