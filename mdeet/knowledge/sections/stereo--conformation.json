mation","unitId":"stereo","subject":"chemistry","text":"cyclopropane은 결합각 strain이 크다.","kind":"highlight","scope":"current-scope-candidate","verificationStatus":"draft-not-independently-verified","referenceIds":["organic10"]},{"id":"stereo--conformation-k015","sectionId":"stereo/conformation","unitId":"stereo","subject":"chemistry","text":"큰 치환기의 equatorial 선호는 입체 상호작용 감소 때문이다.","kind":"highlight","scope":"current-scope-candidate","verificationStatus":"draft-not-independently-verified","referenceIds":["organic10"]},{"id":"stereo--conformation-k016","sectionId":"stereo/conformation","unitId":"stereo","subject":"chemistry","text":"위쪽 equatorial 치환기가 된다.","kind":"review-answer","scope":"current-scope-candidate","verificationStatus":"draft-not-independently-verified","referenceIds":["organic10"]}]}