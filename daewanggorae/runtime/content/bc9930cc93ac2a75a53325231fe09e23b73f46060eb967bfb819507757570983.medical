      }
    },
    {
      "id": "physiology.respiratory.mechanics-compliance.equation.core",
      "type": "equation",
      "latex": "C=\\frac{\\Delta V}{\\Delta P},\\quad R=\\frac{\\Delta P}{\\dot V},\\quad \\tau=RC",
      "variables": {
