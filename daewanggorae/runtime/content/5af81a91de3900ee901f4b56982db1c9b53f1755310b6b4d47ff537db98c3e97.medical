{"id":"question.cardiology.arrhythmias.atrial-fibrillation-burden.001","kind":"original_concept_question","lessonId":"cardiology.arrhythmias.atrial-fibrillation-burden","media":{"items":[{"columns":[{"id":"c0","label":"항목"},{"id":"c1","label":"자료"}],"id":"question.cardiology.arrhythmias.atrial-fibrillation-burden.001.media.table","rows":[{"cells":["착용","48h"],"id":"r0"},{"cells":["유효 기록","24h"],"id":"r1"},{"cells":["확인 AF","6h"],"id":"r2"}],"stage":"question","title":"독립 작성 증례·실험 자료","type":"table"}],"schemaVersion":"1.0.0"},"options":[{"id":"A","text":"검출되지 않은24시간도 반드시 AF가 없었다."},{"id":"B","text":"부담 하나가 모든 항응고 결정을 확정한다."},{"id":"C","text":"25%다."},{"id":"D","text":"12.5%로 유효 기록 부담이다."}],"prompt":"패치 착용48시간 중 유효 기록은24시간이었고 확인된 AF는6시간이었다. 유효 기록 대비 부담은?","verificationStatus":"editorial_draft_not_exam_validated"}