<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 960" role="img"><title>섭취·흡수·외부 손실의 구별</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.stoma-intake-absorption-loss-0849.e0" d="M350,116 L350,204" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="333.902" y="129.3" width="32.196" height="24.7" fill="#fff"/><text x="350" y="148" font-size="18.7" text-anchor="middle" fill="#657482">유입</text><path id="diagram.stoma-intake-absorption-loss-0849.e1" d="M307.45,296 L207.55,404" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="226.255" y="319.3" width="62.49" height="24.7" fill="#fff"/><text x="257.5" y="338" font-size="18.7" text-anchor="middle" fill="#657482">흡수 경로</text><path id="diagram.stoma-intake-absorption-loss-0849.e2" d="M392.55,296 L492.45,404" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="411.255" y="319.3" width="62.49" height="24.7" fill="#fff"/><text x="442.5" y="338" font-size="18.7" text-anchor="middle" fill="#657482">배출 경로</text><path id="diagram.stoma-intake-absorption-loss-0849.e3" d="M165,496 L165,604" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="128.706" y="519.3" width="72.588" height="24.7" fill="#fff"/><text x="165" y="538" font-size="18.7" text-anchor="middle" fill="#657482">몸으로 이동</text><path id="diagram.stoma-intake-absorption-loss-0849.e4" d="M165,696 L165,804" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="133.755" y="