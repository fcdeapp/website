<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 680" role="img"><title>치루 통로와 괄약근의 개념</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.anal-fistula-route-concepts-0850.e0" d="M350,126 L350,254" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="303.608" y="159.3" width="92.784" height="24.7" fill="#fff"/><text x="350" y="178" font-size="18.7" text-anchor="middle" fill="#657482">발생·연결 가능</text><path id="diagram.anal-fistula-route-concepts-0850.e1" d="M315.96,346 L199.04,504" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="211.108" y="394.3" width="92.784" height="24.7" fill="#fff"/><text x="257.5" y="413" font-size="18.7" text-anchor="middle" fill="#657482">괄약근간형 개념</text><path id="diagram.anal-fistula-route-concepts-0850.e2" d="M384.04,346 L500.96,504" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="406.206" y="394.3" width="72.588" height="24.7" fill="#fff"/><text x="442.5" y="413" font-size="18.7" text-anchor="middle" fill="#657482">관통형 개념</text><g id="crypt"><rect x="200" y="34" width="300" height="92" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">샘·항문관 쪽</text></g><g id="space"><rect x="180" y="254" width="340" height="92" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="307.7" font-size="22" text-anchor="middle" fill="#17212b">괄약근 사이 공간</text></g><g id="inter"><rect x="35" y="504" width="260" height="92" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="165" y="557.7" font-size="22" text-anchor="middle" fill="#17212b">사이로 가는 경로</text></g><g id="trans"><rect x="395" y="504" width="280" height="92" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="535" y="557.7" font-size="22" text-anchor="middle" fill="#17212b">외괄약근 횡단 경로</text></g></g></svg>