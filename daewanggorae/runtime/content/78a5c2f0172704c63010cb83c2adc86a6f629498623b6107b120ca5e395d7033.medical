        {
          "id": "ann.71fe20cddcb3ad5ac15e",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 129,
            "end": 175,
            "exact": "체온 조절과 관련된 교감신경이지만 절후섬유에서 아세틸콜린이 중요한 예외를 기억한다.",
            "prefix": "분비부의 처음 액체와 같지 않을 수 있다. ",
            "suffix": " 아포크린땀샘은 특정 부위의 털집과 관련되며"
          },
