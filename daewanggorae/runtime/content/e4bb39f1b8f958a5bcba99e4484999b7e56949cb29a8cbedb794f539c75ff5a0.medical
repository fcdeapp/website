    {
      "blockId": "anatomy.upper-limb.hand-intrinsics.b.0b0bffdecdf3",
      "sourceSha256": "0b0bffdecdf3236c281178fb1af23e4df1967c30b523921f089b85003f353e54",
      "sourceLengthUtf16": 215,
      "annotations": [
        {
          "id": "ann.f4999a4b9761a4fb78e3",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 147,
            "end": 215,
            "exact": "힘줄이 이어져 있다는 사실과 신경에 의해 근육이 정상적으로 작동한다는 사실을 구분해야 손가락 운동 이상을 해석할 수 있다.",
            "prefix": "게 들리지 않게 하고 힘 전달을 유지한다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
      "blockId": "anatomy.upper-limb.hand-intrinsics.b.6461d974f81a",
      "sourceSha256": "6461d974f81a877fb4793442e292052ed7e26d2067beb3ea20f9257449e4e2e8",
      "sourceLengthUtf16": 194,
      "annotations": [
        {
          "id": "ann.c8c505d20ca2dd38f2f4",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 121,
            "end": 194,
            "exact": "그러나 통증이나 관절 강직 및 인접 손가락의 협동이 검사에 영향을 주므로 동작이 안 된다는 사실만으로 신경 손상을 확정하지 않는다.",
            "prefix": "기능의 서로 다른 부분을 평가할 수 있다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
      "blockId": "anatomy.upper-limb.hand-intrinsics.b.8098029b54cb",
      "sourceSha256": "8098029b54cb975ecd8b14479ebb8926f8bd9e756bae032e026f1817074ef00b",
      "sourceLengthUtf16": 226,
      "annotations": [
        {
          "id": "ann.93fcd8dbc5b638c3df59",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 193,
            "end": 226,
            "exact": "정중신경의 되돌이운동가지가 이 근육군의 중요한 지배를 한다.",
            "prefix": "순한 한 관절 굽힘보다 복합적인 운동이다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
