        {
          "id": "ann.f81ec7401b87022838e3",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 25,
            "end": 142,
            "exact": "산소화된 혈액은 제대정맥을 통해 태아로 들어오고, 정맥관(ductus venosus), 타원구멍(foramen ovale), 동맥관(ductus arteriosus)은 혈류의 우회와 분배에 중요한 역할을 한다.",
            "prefix": "아는 폐보다 태반에서 가스교환을 수행한다. ",
            "suffix": " 제대동맥은 태아에서 태반으로 혈액을 보낸다"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
      "blockId": "neonatology.transition.circulation.b.15690b115796",
      "sourceSha256": "15690b115796a6939c4b3214184f5d0647640aa02cfa19450f6ee076f6f649e6",
      "sourceLengthUtf16": 206,
      "annotations": [
        {
