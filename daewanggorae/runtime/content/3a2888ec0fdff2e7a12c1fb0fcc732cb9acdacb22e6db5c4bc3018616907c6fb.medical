"<div class=\"dataset-evidence \"><div class=\"evidence\"><div class=\"measurement-panels\"><figure class=\"measurement-panel\"><figcaption>투여 후 채혈 시각과 농도</figcaption><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 580 355\" role=\"img\" aria-label=\"투여 후 채혈 시각과 농도。직전 투여 후 시간 (h)、약물농도 (mg/L)\"><rect x=\"0\" y=\"0\" width=\"580\" height=\"355\" fill=\"white\"></rect><line x1=\"76\" y1=\"45\" x2=\"76\" y2=\"229\" stroke=\"black\"></line><line x1=\"76\" y1=\"229\" x2=\"526\" y2=\"229\" stroke=\"black\"></line><text x=\"20\" y=\"25\">약물농도 (mg/L)</text><line x1=\"76\" y1=\"229\" x2=\"76\" y2=\"234\" stroke=\"black\"></line><text x=\"76\" y=\"255\" text-anchor=\"middle\">0</text><line x1=\"186\" y1=\"229\" x2=\"186\" y2=\"234\" stroke=\"black\"></line><text x=\"186\" y=\"255\" text-anchor=\"middle\">6</text><line x1=\"296\" y1=\"229\" x2=\"296\" y2=\"234\" stroke=\"black\"></line><text x=\"296\" y=\"255\" text-anchor=\"middle\">12</text><line x1=\"406\" y1=\"229\" x2=\"406\" y2=\"234\" stroke=\"black\"></line><text x=\"406\" y=\"255\" text-anchor=\"middle\">18</text><line x1=\"516\" y1=\"229\" x2=\"516\" y2=\"234\" stroke=\"black\"></line><text x=\"516\" y=\"255\" text-anchor=\"middle\">24</text><line x1=\"71\" y1=\"229\" x2=\"76\" y2=\"229\" stroke=\"black\"></line><text x=\"65\" y=\"234\" text-anchor=\"end\">0</text><line x1=\"71\" y1=\"185.5\" x2=\"76\" y2=\"185.5\" stroke=\"black\"></line><text x=\"65\" y=\"190.5\" text-anchor=\"end\">7.5</text><line x1=\"71\" y1=\"142\" x2=\"76\" y2=\"142\" stroke=\"black\"></line><text x=\"65\" y=\"147\" text-anchor=\"end\">15</text><line x1=\"71\" y1=\"98.5\" x2=\"76\" y2=\"98.5\" stroke=\"black\"></line><text x=\"65\" y=\"103.5\" text-anchor=\"end\">22.5</text><line x1=\"71\" y1=\"55\" x2=\"76\" y2=\"55\" stroke=\"black\"></line><text x=\"65\" y=\"60\" text-anchor=\"end\">30</text><circle cx=\"94.33333333333333\" cy=\"94.44\" r=\"3.2\" fill=\"white\" stroke=\"black\"></circle><circle cx=\"149.33333333333331\" cy=\"119.96\"