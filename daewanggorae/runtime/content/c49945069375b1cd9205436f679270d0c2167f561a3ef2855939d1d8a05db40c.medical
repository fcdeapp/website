        {
          "id": "ann.ef673426f93ac188e0e8",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 54,
            "end": 107,
            "exact": "최고기도압이 올라갔을 때는 분비물이나 관의 문제, 기관지 수축과 탄성 변화 등을 구별해야 한다.",
            "prefix": " 흐름과 환자의 호흡 노력이 영향을 준다. ",
            "suffix": " 적절한 조건에서 측정한 고원압은 흐름 저항"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
