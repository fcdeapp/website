          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 226,
            "end": 229,
            "exact": "약동학",
            "prefix": "이지만 안전한 적용은 신경해부, 전기생리, ",
            "suffix": "과 전신 생리를 함께 요구한다."
          },
          "conceptId": "reader.term.5b6a5f213a56c7b7",
