        },
        {
          "id": "ann.0a162cd4057a5856fcb4",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 71,
            "end": 132,
            "exact": "시술 뒤 새로 발생한 신경학적 이상이 약물 효과인지, 신경 손상이나 혈종 등 다른 합병증인지도 구별해야 한다.",
            "prefix": ", 간 기능과 심장 상태를 기록해야 한다. ",
            "suffix": " 약물의 정상적인 소실에 맞추어 기능이 돌아"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
