      "sourceLengthUtf16": 247,
      "annotations": [
        {
          "id": "ann.9b141bc38b6affbaa311",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 185,
            "end": 247,
            "exact": "정상 참고범위 밖의 수치가 모두 임상적으로 중요한 질환은 아니므로 개별 결과를 사전확률과 검사 목적에 연결한다.",
            "prefix": "의 비정상 결과를 받을 가능성이 높아진다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
