        "필라멘트 길이는 일정하며 실제 장력은 계산하지 않음"
      ]
    },
    {
      "id": "histology.muscle.sarcomere-connective.table.three-muscle-types",
      "type": "comparison",
      "data": {
        "title": "세 근육조직의 대표적인 비교",
        "columns": [
          "구분",
          "골격근",
          "심장근",
          "평활근"
        ],
        "rows": [
          [
            "세포·핵",
            "긴 다핵세포·주변핵",
            "가지치는 세포·주로 중심핵",
            "방추형 세포·중심핵"
          ],
          [
            "가로무늬",
            "근절 배열",
            "근절 배열",
            "전형적인 근절 무늬 없음"
          ],
          [
            "세포 간 관계",
            "각 근육섬유를 구분",
            "사이원반의 기계·전기 접합",
            "장기별 간극이음·연결의 차이"
          ],
          [
            "대표 조절",
