      "annotations": [
        {
          "id": "ann.281db52b5ae2f18d4ba5",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 99,
            "end": 181,
            "exact": "건락괴사(caseous necrosis)는 중요한 병리 소견이지만 모든 검체에서 보이는 것은 아니며 다른 질환에서도 유사한 양상이 나타날 수 있다.",
            "prefix": "ma)을 형성하고 주변 림프구가 반응한다. ",
            "suffix": " 조직 모양을 병원체의 직접 증거와 구분하면"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
