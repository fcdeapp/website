      "sourceLengthUtf16": 222,
      "annotations": [
        {
          "id": "ann.532bfcd51f31d56c798b",
          "kind": "conceptLink",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 72,
            "end": 76,
            "exact": "뇌척수액",
            "prefix": "상과 처치를 모두 대신하지 않는다. 혈액과 ",
            "suffix": " 검사는 원인 가설에 따라 선택하고, 천자의"
          },
          "conceptId": "reader.term.c945be38ff68f3d1",
          "targetDocumentId": "neuroanatomy.meninges.ventricles-csf"
        },
        {
          "id": "ann.299130ab8fea354d9c24",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 124,
            "end": 170,
            "exact": "같은 약화라도 염증과 감염·압박의 치료가 다르므로 원인을 확인하는 과정이 중요하다.",
            "prefix": " 안전과 검사 전 치료의 필요를 검토한다. ",
            "suffix": " 다만 확진이 늦어지는 동안 현재의 신경 기"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
