    },
    {
      "blockId": "neurology.spinal.myelopathy-cauda-equina.b.111ad222bfdf",
      "sourceSha256": "111ad222bfdf16999ba3018eaf3f7c078eaad853501190f779e441c9e472a195",
      "sourceLengthUtf16": 229,
      "annotations": [
        {
          "id": "ann.0e2c91a99e0e01136782",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 44,
            "end": 85,
            "exact": "암과 면역 저하, 발열과 최근 시술·항응고 노출, 외상은 중요한 맥락이다.",
            "prefix": "발생 속도와 배경, 필요한 치료가 다르다. ",
            "suffix": " 위험이 의심되는 환자에서 진통 효과만 기다"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
      "blockId": "neurology.spinal.myelopathy-cauda-equina.b.956b3404b12d",
