        {
          "id": "ann.745cbab43a0faf85aa6d",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 48,
            "end": 103,
            "exact": "소변이 적다고 모두 세뇨관 괴사인 것은 아니고, 소변이 유지된다고 중요한 손상이 없는 것도 아니다.",
            "prefix": "수분 처리 및 배출 경로에 영향을 받는다. ",
            "suffix": " 도뇨관의 막힘과 측정 누락 등 기술적 문제"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
