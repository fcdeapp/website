            "offsetUnit": "utf16",
            "start": 110,
            "end": 116,
            "exact": "사구체여과율",
            "prefix": "급격히 변하는 상태에서 평형을 가정한 추정 ",
            "suffix": "을 실제 현재 여과율처럼 정밀하게 해석하지 "
          },
          "conceptId": "reader.term.301f3dc8f905a00f",
          "targetDocumentId": "physiology.renal.filtration"
        }
