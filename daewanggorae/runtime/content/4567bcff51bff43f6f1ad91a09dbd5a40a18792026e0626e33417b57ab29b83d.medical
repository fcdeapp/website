<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 940" role="img"><title>RAAS 약물의 표적과 결과</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.raas-target-pairs.e0" d="M350,124 L350,181" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="293.51" y="121.8" width="112.98" height="24.7" fill="#fff"/><text x="350" y="140.5" font-size="18.7" text-anchor="middle" fill="#657482">수용체 차단과 구별</text><path id="diagram.raas-target-pairs.e1" d="M350,414 L350,471" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="283.412" y="411.8" width="133.176" height="24.7" fill="#fff"/><text x="350" y="430.5" font-size="18.7" text-anchor="middle" fill="#657482">혈중 농도와 작용 구별</text><path id="diagram.raas-target-pairs.e2" d="M350,704 L350,761" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="268.265" y="701.8" width="163.47" height="24.7" fill="#fff"/><text x="350" y="720.5" font-size="18.7" text-anchor="middle" fill="#657482">장기 이득과 초기 변화 구별</text><g id="n0"><rect x="105" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">ACE 단계 억제</text></g><g id="n1"><rect x="105" y="181" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="232.7" font-size="22" text-anchor="middle" fill="#17212b">Ang II 생성·bradykinin 처리</text></g><g id="n2"><rect x="105" y="326" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="377.7" font-size="22" text-anchor="middle" fill="#17212b">AT1 수용체 차단</text></g><g id="n3"><rect x="105" y="471" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="522.7" font-size="22" text-anchor="middle" fill="#17212b">해당 수용체 매개 반응</text></g><g id="n4"><rect x="105" y="616" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="667.7" font-size="22" text-anchor="middle" fill="#17212b">혈관·원위 네프론 변화</text></g><g id="n5"><rect x="105" y="761" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="812.7" font-size="22" text-anchor="middle" fill="#17212b">BP·Cr·K의 다른 결과</text></g></g></svg>