t-anchor="middle">Oxaloacetate (4C)</text><rect x="430" y="100" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="540" y="135" text-anchor="middle">Citrate (6C)</text><rect x="730" y="240" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="840" y="275" text-anchor="middle">Isocitrate (6C)</text><rect x="730" y="410" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="840" y="445" text-anchor="middle">alpha-Ketoglutarate (5C)</text><rect x="730" y="590" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="840" y="625" text-anchor="middle">Succinyl-CoA (4C)</text><rect x="430" y="710" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="540" y="745" text-anchor="middle">Succinate (4C)</text><rect x="120" y="590" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="230" y="625" text-anchor="middle">Fumarate (4C)</text><rect x="120" y="360" width="220" height="60" rx="9" fill="#f6f3fb" stroke="#b6a4ce"/><text class="label" x="230" y="395" text-anchor="middle">Malate (4C)</text></svg>