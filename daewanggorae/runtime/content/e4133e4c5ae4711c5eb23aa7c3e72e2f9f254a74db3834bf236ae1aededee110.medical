<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 700 750" role="img"><title>간의 혈액·담즙 흐름 개념</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.liver-blood-bile-flow-0850.e0" d="M165,126 L165,264" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="148.902" y="164.3" width="32.196" height="24.7" fill="#fff"/><text x="165" y="183" font-size="18.7" text-anchor="middle" fill="#657482">혈액</text><path id="diagram.liver-blood-bile-flow-0850.e1" d="M165,356 L165,554" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="133.755" y="424.3" width="62.49" height="24.7" fill="#fff"/><text x="165" y="443" font-size="18.7" text-anchor="middle" fill="#657482">혈액 배출</text><path id="diagram.liver-blood-bile-flow-0850.e2" d="M305,310 L415,310" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)" marker-start="url(#reverse)"/><rect x="343.902" y="279.3" width="32.196" height="24.7" fill="#fff"/><text x="360" y="298" font-size="18.7" text-anchor="middle" fill="#657482">교환</text><path id="diagram.liver-blood-bile-flow-0850.e3" d="M535,356 L535,554" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="488.608" y="424.3" width="92.784" height="24.7" fill="#fff"/><text x="535" y="443" font-size="18.7" text-anchor="middle" fill="#657482">담즙 분비·배출</text><g id="in"><rect x="25" y="34" width="280" height="92" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="165" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">문맥