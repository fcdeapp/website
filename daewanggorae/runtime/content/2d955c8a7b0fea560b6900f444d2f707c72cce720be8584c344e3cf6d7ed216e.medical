          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 0,
            "end": 92,
            "exact": "다운증후군(Down syndrome)의 핵심은21번 염색체 장완의 관련 유전물질이 추가되는 것이며, 자유 삼염색체가 대표적이지만 재배열이나 모자이크 구성도 가능하다.",
            "prefix": "",
            "suffix": " 따라서 염색체 총수가 항상47이어야 한다고"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
