<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 940" role="img"><title>티아민의 반응과 결과</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.thiamine-reaction-pairs.e0" d="M350,124 L350,181" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="293.51" y="121.8" width="112.98" height="24.7" fill="#fff"/><text x="350" y="140.5" font-size="18.7" text-anchor="middle" fill="#657482">연료량과 이용 구별</text><path id="diagram.thiamine-reaction-pairs.e1" d="M350,414 L350,471" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="273.314" y="411.8" width="153.372" height="24.7" fill="#fff"/><text x="350" y="430.5" font-size="18.7" text-anchor="middle" fill="#657482">직접 NADPH 생성 아님</text><path id="diagram.thiamine-reaction-pairs.e2" d="M350,704 L350,761" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="308.657" y="701.8" width="82.686" height="24.7" fill="#fff"/><text x="350" y="720.5" font-size="18.7" text-anchor="middle" fill="#657482">삼징후의 한계</text><g id="n0"><rect x="105" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">PDH·αKGDH 등</text></g><g id="n1"><rect x="105" y="181" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="232.7" font-size="22" text-anchor="middle" fill="#17212b">탄소 흐름·산화 대사</text></g><g id="n2"><rect x="105" y="326" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="377.7" font-size="22" text-anchor="middle" fill="#17212b">Transketolase</text></g><g id="n3"><rect x="105" y="471" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="522.7" font-size="22" text-anchor="middle" fill="#17212b">비산화적 탄소 재배치</text></g><g id="n4"><rect x="105" y="616" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="667.7" font-size="22" text-anchor="middle" fill="#17212b">영양 위험·임상 소견</text></g><g id="n5"><rect x="105" y="761" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="812.7" font-size="22" text-anchor="middle" fill="#17212b">검사와 신속한 대응</text></g></g></svg>