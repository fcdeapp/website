      "annotations": [
        {
          "id": "ann.8863267dd3ddf865770f",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 28,
            "end": 84,
            "exact": "폐동맥압이 높아도 원인이 큰 유량인지, 좌심방 압력 전달인지, 폐혈관 저항의 상승인지 구별해야 한다.",
            "prefix": "혈류와 높은 폐혈관 저항은 다른 개념이다. ",
            "suffix": " 저항은 압력차를 유량으로 나눈 관계로 표현"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
