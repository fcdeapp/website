            "offsetUnit": "utf16",
            "start": 0,
            "end": 50,
            "exact": "유전물질의 총량이 유지되는 균형 재배열과 일부가 늘거나 줄어드는 불균형 재배열을 구별한다.",
            "prefix": "",
            "suffix": " 균형이라는 표현은 관찰 방법이 확인한 복제"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
