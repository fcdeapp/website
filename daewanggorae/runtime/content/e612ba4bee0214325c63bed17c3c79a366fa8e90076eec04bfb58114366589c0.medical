<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 940" role="img"><title>RNA 가공의 서로 다른 질문</title><defs><marker id="arrow" markerWidth="7" markerHeight="7" refX="7" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="#655381"/></marker><marker id="reverse" markerWidth="7" markerHeight="7" refX="0" refY="3.5" orient="auto"><path d="M7,0 L0,3.5 L7,7 Z" fill="#655381"/></marker><marker id="inhibition" markerWidth="3" markerHeight="12" refX="1.5" refY="6" orient="auto"><path d="M1.5,0 L1.5,12" stroke="#655381" stroke-width="1.5"/></marker></defs><g font-family="sans-serif"><path id="diagram.rna-processing-pairs.e0" d="M350,124 L350,181" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="303.608" y="121.8" width="92.784" height="24.7" fill="#fff"/><text x="350" y="140.5" font-size="18.7" text-anchor="middle" fill="#657482">특수 연결 형성</text><path id="diagram.rna-processing-pairs.e1" d="M350,414 L350,471" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="318.755" y="411.8" width="62.49" height="24.7" fill="#fff"/><text x="350" y="430.5" font-size="18.7" text-anchor="middle" fill="#657482">스플라이싱</text><path id="diagram.rna-processing-pairs.e2" d="M350,704 L350,761" stroke="#655381" fill="none" stroke-width="2" marker-end="url(#arrow)"/><rect x="293.51" y="701.8" width="112.98" height="24.7" fill="#fff"/><text x="350" y="720.5" font-size="18.7" text-anchor="middle" fill="#657482">대부분mRNA의경로</text><g id="n0"><rect x="105" y="36" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="87.7" font-size="22" text-anchor="middle" fill="#17212b">5′말단 캡</text></g><g id="n1"><rect x="105" y="181" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="232.7" font-size="22" text-anchor="middle" fill="#17212b">보호·인식·번역 연결</text></g><g id="n2"><rect x="105" y="326" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="377.7" font-size="22" text-anchor="middle" fill="#17212b">인트론 제거·엑손 연결</text></g><g id="n3"><rect x="105" y="471" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="522.7" font-size="22" text-anchor="middle" fill="#17212b">성숙 전사체의 구간 선택</text></g><g id="n4"><rect x="105" y="616" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="667.7" font-size="22" text-anchor="middle" fill="#17212b">3′절단 뒤 poly(A)</text></g><g id="n5"><rect x="105" y="761" width="490" height="88" rx="3" fill="#fff" stroke="#655381" stroke-width="1.5"/><text x="350" y="812.7" font-size="22" text-anchor="middle" fill="#17212b">말단 형성·안정성 연결</text></g></g></svg>