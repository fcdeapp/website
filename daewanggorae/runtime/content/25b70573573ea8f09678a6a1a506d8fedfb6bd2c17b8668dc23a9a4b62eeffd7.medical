          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 192,
            "end": 227,
            "exact": "양쪽 눈을 함께 움직이는 것과 한쪽 눈의 개별 운동도 구별한다.",
            "prefix": "용을 상대적으로 분리하여 보는지 이해한다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
