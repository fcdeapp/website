      }
    },
    {
      "id": "physiology.respiratory.diffusion-oxygen.equation.core",
      "type": "equation",
      "latex": "C_{mix}=\\frac{Q_1C_1+Q_2C_2}{Q_1+Q_2}",
      "variables": {
        "Cmix": "혼합 산소함량 (mL/dL)",
        "Q1": "첫 혈류 유량",
        "Q2": "둘째 혈류 유량",
