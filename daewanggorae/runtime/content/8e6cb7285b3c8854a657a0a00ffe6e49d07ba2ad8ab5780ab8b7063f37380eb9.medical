          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 150,
            "end": 206,
            "exact": "통증의 위치는 병변 수준의 단서지만 단일 부위의 통증만으로 정확한 협착 위치와 수를 확정하지 않는다.",
            "prefix": "dication)을 이해하는 한 기전이다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
