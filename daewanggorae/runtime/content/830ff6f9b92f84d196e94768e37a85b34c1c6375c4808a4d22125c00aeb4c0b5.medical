          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 200,
            "end": 246,
            "exact": "담즙 정체가 발생하면 배출 경로의 어느 수준이 손상되었는지 구별하는 것이 중요하다.",
            "prefix": "을 둘러싸고 담즙 성분 조절에도 관여한다. ",
            "suffix": ""
          },
          "level": "key",
