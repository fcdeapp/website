          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 131,
            "end": 176,
            "exact": "치료 중 새 발열이나 발진이 생기면 감염 지속과 약물반응, 다른 원인을 구분한다.",
            "prefix": "신장·간담도 반응 등도 약물별로 검토한다. ",
            "suffix": " 새로운 증상 하나를 곧바로 치료 실패로 판"
          },
          "level": "key",
