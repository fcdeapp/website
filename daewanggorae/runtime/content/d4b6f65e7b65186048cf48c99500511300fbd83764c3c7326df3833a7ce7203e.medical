          ],
          [
            "전신 반응",
            "순환 복합체와 여러 침착 부위"
          ],
          [
            "보체 저하",
            "소모의 단서이나 단독으로 침착을 확정하지 않음"
          ],
          [
            "조직 확인",
            "침착 양상과 염증·임상 경과의 통합"
          ]
        ]
      }
    }
  ],
