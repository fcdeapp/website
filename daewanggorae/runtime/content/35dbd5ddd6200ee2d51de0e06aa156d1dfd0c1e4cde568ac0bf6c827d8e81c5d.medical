        {
          "id": "ann.513d3ca4e5ecf54c8e13",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 49,
            "end": 95,
            "exact": "새 신경 증상에서는 허혈과 출혈, 감염성 동맥류나 농양 등 가능한 병변을 구별한다.",
            "prefix": "심장 병변은 폐혈관에 영향을 줄 수 있다. ",
            "suffix": " 심내막염의 뇌 사건에 일반적인 혈전성 뇌졸"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
      ]
    },
    {
      "blockId": "cardiology.infection.endocarditis-complications.b.b5f9b768614d",
