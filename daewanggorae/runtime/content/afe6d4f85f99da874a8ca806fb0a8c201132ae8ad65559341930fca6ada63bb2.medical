          "kind": "conceptLink",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 109,
            "end": 112,
            "exact": "심부전",
            "prefix": "다른 병소는 감염원 조절의 질문을 만든다. ",
            "suffix": "·색전·약물성 또는 다른 비감염성 질환도 감"
          },
