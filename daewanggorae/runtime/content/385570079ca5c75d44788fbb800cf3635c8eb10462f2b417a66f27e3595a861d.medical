        {
          "id": "ann.861195710c1e14ae8d32",
          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 109,
            "end": 171,
            "exact": "진찰 한 번의 긴장도만으로 중추와 말초를 확정하지 않고 시간경과, 반사, 감각, 뇌신경 소견과 분포를 통합한다.",
            "prefix": "따라 감각과 운동 소견이 다르게 나타난다. ",
            "suffix": " 근육 질환과 신경근접합부 질환도 서로 다른"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
