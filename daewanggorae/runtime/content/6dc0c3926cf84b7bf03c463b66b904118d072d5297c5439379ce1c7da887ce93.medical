          ],
          [
            "유발기",
            "재노출 조직의 T세포 반응"
          ],
          [
            "자극접촉피부염",
            "특이 적응면역 감작 없이도 발생"
          ],
          [
            "첩포시험",
            "검사 조건·판독 시점과 임상 관련성 확인"
          ]
        ]
      }
    }
  ],
