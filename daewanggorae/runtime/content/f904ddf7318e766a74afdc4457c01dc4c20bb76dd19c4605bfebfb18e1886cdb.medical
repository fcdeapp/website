{"id":"question.psychiatry.anxiety.panic-ocd.002","kind":"original_concept_question","lessonId":"psychiatry.anxiety.panic-ocd","media":{"items":[{"columns":[{"id":"c0","label":"항목"},{"id":"c1","label":"자료"}],"id":"question.psychiatry.anxiety.panic-ocd.002.media.table","rows":[{"cells":["행동 전","80"],"id":"r0"},{"cells":["5분","40"],"id":"r1"},{"cells":["이후","10분55·20분75"],"id":"r2"}],"stage":"question","title":"독립 작성 증례·실험 자료","type":"table"},{"diagramRef":"diagram.synthetic-checking-distress-0852","id":"question.psychiatry.anxiety.panic-ocd.002.graph","stage":"question","type":"diagram"}],"schemaVersion":"1.0.0"},"options":[{"id":"A","text":"감소가 있으면 장기 회복과 모든 원인이 확정된다."},{"id":"B","text":"40점과50%다."},{"id":"C","text":"40점과100%다."},{"id":"D","text":"75점과93.75%다."}],"prompt":"가상 확인 행동 전 불편 평정80,5분 뒤40,10분55,20분75다. 표와 곡선에서 처음5분의 절대·상대 감소를 고르시오. 공식 척도·전형적OCD경과·치료효과가 아니며,단기 완화와 반복 행동의 기능·장기 학습을 구별한다.","verificationStatus":"editorial_draft_not_exam_validated"}