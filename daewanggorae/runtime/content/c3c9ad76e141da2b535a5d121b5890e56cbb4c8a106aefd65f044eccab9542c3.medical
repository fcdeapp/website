          "kind": "highlight",
          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 135,
            "end": 197,
            "exact": "국소 침윤·림프혈관 침범·전이 병변의 관찰은 서로 다른 정보이며 하나가 나머지를 자동으로 모두 확정하지 않는다.",
            "prefix": "관과 면역 환경,관찰 시점이 영향을 준다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
