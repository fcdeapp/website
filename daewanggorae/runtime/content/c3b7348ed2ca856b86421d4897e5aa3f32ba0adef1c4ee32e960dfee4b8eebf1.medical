            "offsetUnit": "utf16",
            "start": 147,
            "end": 216,
            "exact": "경동맥소체와 목동맥굴(carotid sinus)의 압수용 기능은 위치가 가깝지만 감지 변수와 역할이 다르므로 구별해야 한다.",
            "prefix": "라 이산화탄소와 산염기 변화에도 반응한다. ",
            "suffix": ""
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
