            "start": 101,
            "end": 148,
            "exact": "가려움과 분비물이 주된 경우와 심한 통증·눈부심·시력 저하가 동반된 경우를 구별한다.",
            "prefix": "구 내부에서 시작한 질환의 의미는 다르다. ",
            "suffix": " 겉으로 붉은 범위가 넓다는 사실만으로 질환"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
        }
