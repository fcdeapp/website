"<div class=\"dataset-evidence batch-C01 c01-batch\"><div class=\"evidence\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 470\" role=\"img\" aria-label=\"구조 관계를 단순화한 교육용 모식도\"><rect width=\"800\" height=\"470\" fill=\"white\"></rect><text x=\"100\" y=\"45\" font-size=\"28\" style=\"font-size:28px\" fill=\"#111\">가: 띠 장력 없음</text><text x=\"470\" y=\"45\" font-size=\"28\" style=\"font-size:28px\" fill=\"#111\">나: 띠 장력 있음</text><path d=\"M80 140Q135 210 80 280M440 140Q495 210 440 280\" stroke=\"#111\" stroke-width=\"5\" fill=\"none\"></path><ellipse cx=\"230\" cy=\"190\" rx=\"80\" ry=\"80\" stroke=\"#111\" fill=\"white\" stroke-width=\"2\"></ellipse><ellipse cx=\"590\" cy=\"240\" rx=\"80\" ry=\"80\" stroke=\"#111\" fill=\"white\" stroke-width=\"2\"></ellipse><ellipse cx=\"230\" cy=\"190\" rx=\"5\" ry=\"5\" stroke=\"#111\" fill=\"white\" stroke-width=\"2\"></ellipse><ellipse cx=\"590\" cy=\"240\" rx=\"5\" ry=\"5\" stroke=\"#111\" fill=\"white\" stroke-width=\"2\"></ellipse><line x1=\"230\" y1=\"50\" x2=\"230\" y2=\"100\" stroke=\"#111\" stroke-width=\"3\"></line><line x1=\"590\" y1=\"90\" x2=\"590\" y2=\"150\" stroke=\"#111\" stroke-width=\"3\"></line><path d=\"M220 100L230 80L240 100M580 150L590 130L600 150\" stroke=\"#111\" stroke-width=\"3\" fill=\"none\"></path><path d=\"M440 140L590 160M440 280L590 320\" stroke=\"#111\" stroke-width=\"3\" fill=\"none\"></path><text x=\"140\" y=\"355\" font-size=\"28\" style=\"font-size:28px\" fill=\"#111\">머리가 위로 이동</text><text x=\"500\" y=\"355\" font-size=\"28\" style=\"font-size:28px\" fill=\"#111\">중심 이동 작음</text><text x=\"20\" y=\"455\" font-size=\"24\" style=\"font-size:24px\">독립 제작 모식도 · 크기 비례 아님</text></svg></div></div>"