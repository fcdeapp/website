{"evidence":[{"assessmentRole":"required","data":{"origin":"schematic","presetId":"p12"},"id":"C01-ev-12-plate","templateId":"C01.F-D01.anatomy","templateVersion":"1.0.0","type":"F-D01"}],"id":"question.anatomy.head-neck.larynx-vocal-folds.001","leadIn":"해당 근육은?","learningObjective":"후두 근육의 운동을 관찰된 형태 변화와 연결한다.","profile":"basic-school","response":{"options":[{"id":"A","text":"가쪽반지피열근"},{"id":"B","text":"방패피열근"},{"id":"C","text":"반지방패근"},{"id":"D","text":"가로피열근"},{"id":"E","text":"뒤반지피열근"}],"type":"A01"},"review":{"medicalExpertReviewed":false,"status":"candidate_awaiting_user_review"},"revision":"C01.base-0.8.77.r1","schemaVersion":"2.0.0","shell":"SH03","stem":"후두를 위에서 본 두 모식도는 같은 후두의 가·나 상태다. 피열연골의 성대돌기는 점으로 표시했다. 가→나에서 관찰되는 운동을 일으키는 주된 근육을 묻는다."}