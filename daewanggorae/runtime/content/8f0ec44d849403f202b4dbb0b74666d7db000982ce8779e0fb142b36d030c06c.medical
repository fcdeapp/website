          "selector": {
            "type": "TextPositionAndQuote",
            "offsetUnit": "utf16",
            "start": 67,
            "end": 122,
            "exact": "전자에서는 기능성 세포의 자극과 합성 과정이 중요하고 후자에서는 염증·여포 파괴의 양상이 중요하다.",
            "prefix": "몬이 조직 손상으로 누출된 상태는 다르다. ",
            "suffix": " 따라서 조직학적 모양을 기능검사의 대용으로"
          },
          "level": "key",
          "reason": "distinction_or_caution_rule",
          "reviewStatus": "editorial_seed_not_medically_certified"
